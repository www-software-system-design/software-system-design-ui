{
  "name": "component-lib",
  "version": "0.1.0",
  "private": true,
  "description": "Shared React UI foundations for software-system.design microfrontends",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/atoms/button/index.d.ts",
      "import": "./dist/components/atoms/button/index.js"
    },
    "./provider": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./styles.css": "./dist/styles/index.css"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-components.mjs && depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:stories": "vitest run --config vitest.storybook.config.ts",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "check:package": "node scripts/check-package.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:visual": "playwright test --config tests/visual/playwright.config.ts",
    "generate:component": "node scripts/generate-component.mjs",
    "test:generator": "node --test scripts/generate-component.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:generator && npm run check:package"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "dependency-cruiser": "^17.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "http-server": "^14.1.1"
  }
}
