{
  "name": "@software-system.design/ui",
  "version": "0.1.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Shared React UI foundations for software-system.design microfrontends",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/www-software-system-design/software-system-design-ui.git"
  },
  "bugs": {
    "url": "https://github.com/www-software-system-design/software-system-design-ui/issues"
  },
  "homepage": "https://github.com/www-software-system-design/software-system-design-ui#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/atoms/button/index.d.ts",
      "import": "./dist/components/atoms/button/index.js"
    },
    "./provider": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./tokens.css": "./dist/tokens/tokens.css",
    "./text-input": {
      "types": "./dist/components/atoms/text-input/index.d.ts",
      "import": "./dist/components/atoms/text-input/index.js"
    },
    "./search-field": {
      "types": "./dist/components/molecules/search-field/index.d.ts",
      "import": "./dist/components/molecules/search-field/index.js"
    },
    "./search-panel": {
      "types": "./dist/components/organisms/search-panel/index.d.ts",
      "import": "./dist/components/organisms/search-panel/index.js"
    },
    "./explorer-layout": {
      "types": "./dist/components/templates/explorer-layout/index.d.ts",
      "import": "./dist/components/templates/explorer-layout/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-components.mjs && depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:stories": "vitest run --config vitest.storybook.config.ts",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "check:package": "node scripts/check-package.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:visual": "playwright test --config tests/visual/playwright.config.ts",
    "generate:component": "node scripts/generate-component.mjs",
    "test:generator": "node --test scripts/generate-component.test.mjs",
    "test:config": "node --test scripts/vitest-projects.test.mjs",
    "test:release": "node --test scripts/release.test.mjs",
    "check:release": "node scripts/check-release.mjs",
    "prepublishOnly": "npm run check:release && npm run check:package",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:generator && npm run test:config && npm run test:release && npm run check:package"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "^17.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "http-server": "^14.1.1"
  }
}
